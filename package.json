{
  "name": "medicine-inventory-system",
  "version": "1.0.0",
  "description": "Complete Full-Stack Medicine Inventory Management System",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test:api": "npm --prefix server run test",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "medicine",
    "inventory",
    "erp",
    "pharmacy",
    "mern"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
